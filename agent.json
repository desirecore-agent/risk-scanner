{
  "$schema": "http://desirecore/schemas/agent.json",
  "version": "1.0.0",
  "name": "合同风险识别官",
  "description": "合同审查流水线第 5 步的风险判读者。按触发词库匹配、限定与排除，做 9 项缺失条款检查、4 条市场标尺对标与企业红线检查，产出带结论四元组的争议点清单。误报与漏检同等严重。",
  "author": "DesireCore",
  "avatar": {
    "char": "险",
    "color": "purple"
  },
  "llm": {
    "routingMode": "smart",
    "smart": {
      "profile": {
        "tier": "balanced",
        "requiredCapabilities": ["tool_use", "long_context"],
        "reasoning": "high"
      }
    },
    "maxRetryDelayMs": 32000
  },
  "capabilities": [
    "contract-review",
    "risk-identification",
    "risk-lexicon-matching",
    "trigger-condition-analysis",
    "missing-clause-assessment",
    "market-benchmark-comparison",
    "custom-redline-check",
    "false-positive-suppression",
    "coverage-matrix-authoring"
  ],
  "trigger_patterns": [
    "风险识别",
    "风险判读",
    "风险扫描",
    "争议点",
    "争议点清单",
    "触发词库",
    "关键条款缺失",
    "缺失条款检查",
    "市场标尺",
    "标尺对标",
    "责任上限",
    "续约通知期",
    "竞业期限",
    "数据导出",
    "企业红线",
    "risk scan",
    "risk identification",
    "risk lexicon",
    "missing clause",
    "market benchmark",
    "liability cap",
    "redline check"
  ],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3,
  "command_authority": {
    "enabled": true,
    "allowed_targets": [
      "contract-review-lead",
      "review-reporter"
    ]
  },
  "default_enabled": {
    "skills": [
      "risk-scanning"
    ],
    "tools": []
  },
  "tool_permissions": {
    "allowed": [
      "Read",
      "Ls",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Skill",
      "MathCalc",
      "GenerateUUID",
      "FileDigest",
      "UnderstandImage",
      "AskUserQuestion",
      "Delegate",
      "SendMessage"
    ],
    "denied": [
      "Bash",
      "PowerShell",
      "TerminalControl",
      "HttpRequest",
      "WebFetch",
      "WebSearch",
      "ComputeCredential",
      "ControlDesireCoreGui",
      "BrowserTakeover",
      "RecallConversation",
      "spawn_agent"
    ]
  },
  "network_security": {
    "enableSsrfProtection": true
  },
  "file_security": {
    "restrictToWorkDirs": true
  },
  "compute_credentials": {
    "allowed_providers": []
  },
  "tools": {
    "ask_user_question": {
      "wait_mode": "always_wait"
    }
  },
  "env": {
    "enabled": true,
    "includeWeekday": true,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": false,
    "includeRuntime": false,
    "includeManagedRuntimes": false
  }
}
